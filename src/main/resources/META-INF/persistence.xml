<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!--
      JTA persistence unit. On the application server (Payara/TomEE/WildFly),
      define a JDBC resource/data source named 'jdbc/mazadhub' pointing at the
      MySQL 'mazadhub' database; the container manages transactions.
    -->
    <persistence-unit name="mazadhubPU" transaction-type="JTA">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>jdbc/mazadhub</jta-data-source>

        <class>com.mazadhub.domain.User</class>
        <class>com.mazadhub.domain.Category</class>
        <class>com.mazadhub.domain.Item</class>
        <class>com.mazadhub.domain.Bid</class>
        <class>com.mazadhub.domain.AutoBid</class>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
